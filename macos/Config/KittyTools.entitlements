<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 由 Base.xcconfig 的 CODE_SIGN_ENTITLEMENTS 引用；不开沙盒（ENABLE_APP_SANDBOX = NO）。
     apple-events：启动器系统命令（清倒废纸篓、退出登录 / 重新启动 / 关机），配 Info.plist 的 NSAppleEventsUsageDescription；
     device.audio-input：录屏 / 录音录麦克风，配 NSMicrophoneUsageDescription（Hardened Runtime 下缺了它系统静默拒绝：不弹框、
     隐私设置里也没有这一项） -->
<plist version="1.0">
<dict>
	<!-- 系统管理应用专用 iCloud 文档容器，用户只需开启同步开关。 -->
	<key>com.apple.developer.icloud-services</key>
	<array><string>CloudDocuments</string></array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array><string>iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)</string></array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array><string>iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)</string></array>
	<!-- 自动加密同步经 iCloud 钥匙串传递随机密钥；访问组按正式版与 Dev 版各自的应用身份隔离。 -->
	<key>com.apple.application-identifier</key>
	<string>$(DEVELOPMENT_TEAM).$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>keychain-access-groups</key>
	<array>
		<string>$(DEVELOPMENT_TEAM).$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
